{
  "manifest_version": 3,
  "name": "Universal AI Assistant",
  "version": "1.5.0",
  "description": "Universal context-aware AI assistant with secure page context, resilient streaming, persistent conversations, and automatic update support.",
  "minimum_chrome_version": "102",
  "update_url": "https://raw.githubusercontent.com/swajyottechnologies/universal-browser-ai-assistant/main/updates.xml",
  "permissions": ["storage","activeTab","contextMenus","scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "src/background.js","type": "module"},
  "action": {"default_title": "Open Universal AI Assistant"},
  "commands": {"open-assistant": {"suggested_key": {"default": "Ctrl+Shift+A","mac": "Command+Shift+A"},"description": "Open Universal AI Assistant"}},
  "content_scripts": [{"matches": ["<all_urls>"],"js": ["src/content.js"],"run_at": "document_idle"}],
  "options_page": "src/options.html"
}
